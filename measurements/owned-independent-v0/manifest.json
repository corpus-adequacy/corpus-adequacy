{
  "accepted_exit_codes": [
    0
  ],
  "build": [
    "cargo",
    "build",
    "--release",
    "--locked",
    "--offline"
  ],
  "default_group": "independent",
  "diagnostic_from": [
    "diagnostics"
  ],
  "entrypoint_command": [
    "/work/target/release/corpus-adequacy-owned-fixture",
    "/input/vectors",
    "--json",
    "/work/report.json"
  ],
  "id_key": "id",
  "implementation": "subject/src/check.rs",
  "implementation_sources": [
    "subject/src/check.rs"
  ],
  "mutants": {
    "independent": [
      {
        "anchor": "pub fn check(value: i64, maximum: i64) -> (bool, &'static str, String) {",
        "control": true,
        "id": "control-positive",
        "label": "CONTROL immediate owned-fixture refusal",
        "replacement": "pub fn check(value: i64, maximum: i64) -> (bool, &'static str, String) {\n    return (false, \"control-refusal\", \"positive control\".to_owned());",
        "scope": "declared"
      },
      {
        "anchor": "if value == i64::MIN",
        "control": true,
        "control_polarity": "inert",
        "id": "control-inert",
        "label": "CONTROL remove unreachable minimum sentinel",
        "replacement": "if false",
        "scope": "declared"
      },
      {
        "anchor": "if value > maximum",
        "id": "upper-guard-first-overflow-only",
        "label": "truncate owned-fixture upper guard to the first value above maximum",
        "replacement": "if value > maximum && value <= maximum.saturating_add(1)",
        "scope": "declared"
      }
    ]
  },
  "outcome_from": [
    "rows"
  ],
  "repo_root": "subject",
  "runner": "batch",
  "schema": "corpus-adequacy.manifest.v0",
  "unproved_exit_codes": [
    75
  ],
  "vectors": "corpus/vectors/MANIFEST.json"
}
